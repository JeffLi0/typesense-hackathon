# Point the UI at the Python backend. Leave this UNSET (or commented out) and
# the app runs on the dummy data in src/lib/mockData.js.
# VITE_API_BASE_URL=http://localhost:8000

# Only needed if the frontend ever queries Typesense directly. Today it doesn't
# — the backend owns search. `npm run seed` fills these in automatically.
VITE_TYPESENSE_HOST=localhost
VITE_TYPESENSE_PORT=8108
VITE_TYPESENSE_PROTOCOL=http
VITE_TYPESENSE_SEARCH_KEY=
VITE_TYPESENSE_COLLECTION=diseases
